{
  "description": "DeepSeek Harness Lifecycle Hooks for Mobile and Backend Engineering",
  "version": "1.0.0",
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "bash .harness/hooks/session-start.sh",
        "timeout": 15
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "bash .harness/hooks/user-prompt-gate.sh",
        "timeout": 15
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "bash .harness/hooks/post-tool-guard.sh",
        "timeout": 15
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "bash .harness/hooks/session-stop.sh",
        "timeout": 15
      }
    ]
  }
}
